# ==============================================================
# AI Research & Knowledge Assistant - Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit your actual .env file to version control.
# ==============================================================

# --- LLM Provider ---
# Choose "openai" or "ollama"
LLM_PROVIDER=ollama

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Required if LLM_PROVIDER=ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# --- Embeddings ---
# "huggingface" (local, free) or "openai" or "ollama"
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage Paths ---
UPLOAD_DIR=./data/raw_documents
VECTOR_DB_DIR=./data/vector_db
DATASET_DIR=./data/dataset
TF_MODEL_PATH=./models/tf_classifier.h5
TOKENIZER_PATH=./models/tokenizer.pickle

# --- Database ---
DATABASE_URL=sqlite:///./data/app_metadata.db

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVAL_TOP_K=4

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000